# Unidad de systemd --user que mantiene el sitio corriendo en el puerto 8080.
# Instalar con:  ./hosting/install-service.sh
[Unit]
Description=ads.team6017.com - demos Flutter de las mentorias
After=network.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
Environment=SITE_DIR=__ROOT__/site
Environment=PORT=8080
Environment=HOST=0.0.0.0
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 __ROOT__/hosting/server.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
